# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=1000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3000
BACKEND_URL=http://localhost:1000

# ── Database (PostgreSQL, SSL required) ─────────────────────────────────────
DB_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# ── Auth ────────────────────────────────────────────────────────────────────
# Use two different long random strings (e.g. `openssl rand -hex 48`).
JWT_SECRET_KEY=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRE_IN=15m
JWT_REFRESH_EXPIRE_IN=7d

# Google OAuth (Google Cloud Console → Credentials → OAuth client)
# Authorised redirect URI must be: ${BACKEND_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin seeder (dev only — skipped when NODE_ENV=production) ──────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=Admin
ADMIN_SECRET_KEY=

# ── Email (Resend — OTP + order notifications) ──────────────────────────────
RESEND_API=
# Legacy SMTP fallback (nodemailer)
EMAIL=
PASSWORD=

# ── Cloudinary (product images, payment screenshots) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── WhatsApp (WAHA — https://waha.devlike.pro) ──────────────────────────────
# Store's WhatsApp number in international format without "+"
WHATSAPP_NUMBER=9779817801199
WAHA_URL=
WAHA_SESSION=default
WAHA_API_KEY=

# ── Payment methods (manual verification: QR / bank / COD) ──────────────────
# Set any *_ENABLED to "false" to hide that method at checkout.
ESEWA_ENABLED=true
ESEWA_QR_URL=
ESEWA_ACCOUNT_NAME=Sports Store
ESEWA_ACCOUNT_NUMBER=9800000000

KHALTI_ENABLED=true
KHALTI_QR_URL=
KHALTI_ACCOUNT_NAME=Sports Store
KHALTI_ACCOUNT_NUMBER=9800000000

BANK_ENABLED=true
BANK_NAME=Nepal Bank Ltd.
BANK_BRANCH=Kathmandu
BANK_ACCOUNT_NAME=Sports Store Pvt. Ltd.
BANK_ACCOUNT_NUMBER=0000000000000000

COD_ENABLED=true
